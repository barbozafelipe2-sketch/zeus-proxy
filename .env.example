# Required private access gate (server-only)
ZEUS_PROXY_ACCESS_TOKEN=

# Netlify AI Gateway injects provider keys/base URLs at runtime.
# Optional model overrides only:
OPENAI_STRONG_MODEL=gpt-5.6-sol
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH_MODEL=gpt-5.5
ANTHROPIC_STRONG_MODEL=claude-sonnet-5
GEMINI_STRONG_MODEL=gemini-3.5-flash

# Optional server transcription adapter. Browser speech recognition works without this.
OLYHUB_SERVER_TRANSCRIPTION=false
OLYHUB_AUDIO_BASE_URL=
OLYHUB_AUDIO_API_KEY=
OLYHUB_AUDIO_MODEL=

# Optional independent backup routes. Keep these server-only; never place keys in browser assets.
# Netlify-injected OPENROUTER_API_KEY is the Gateway, NOT the direct backup.
OPENROUTER_DIRECT_API_KEY=
OPENROUTER_DIRECT_BASE_URL=
OPENAI_DIRECT_API_KEY=
OPENAI_DIRECT_BASE_URL=
