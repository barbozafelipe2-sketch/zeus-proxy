# Provider API keys and base URLs are injected at runtime by Netlify AI Gateway.
# Do not add manual provider credentials unless you intentionally want to override the gateway.
OPENAI_MODEL=gpt-6.1-sol
OPENAI_MODEL_CHAIN=gpt-6.1-sol,gpt-6-sol,gpt-5.6-sol,gpt-5.6-terra,gpt-6-luna
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MODEL_CHAIN=claude-sonnet-5,claude-sonnet-4-6,claude-haiku-4-5
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_MODEL_CHAIN=gemini-3.1-pro-preview,gemini-2.5-pro,gemini-3-flash-preview,gemini-2.5-flash
PROVIDER_TIMEOUT_MS=45000
ZEUS_PROVIDER_ORDER=openai,claude,gemini

# Required in production. Generate a unique random value of at least 32 characters.
# The user enters this in the app; it is sent only to this server's chat endpoint.
ZEUS_PROXY_ACCESS_TOKEN=

# Optional server-side persistence. Keep service-role credentials private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
