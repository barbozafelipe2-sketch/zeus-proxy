# Required private access gate (server-only)
ZEUS_PROXY_ACCESS_TOKEN=

# Netlify AI Gateway injects provider keys/base URLs at runtime.
# Optional model overrides only. Validate IDs against your enabled AI Gateway model catalogue:
OPENAI_STRONG_MODEL=gpt-5.6-sol
OPENAI_MODEL=gpt-5.6-luna
OPENAI_WEB_SEARCH_MODEL=gpt-5.5
ANTHROPIC_STRONG_MODEL=claude-sonnet-5
GEMINI_STRONG_MODEL=gemini-3.5-flash

# Voice input is processed directly by ElevenLabs Scribe v2. No alternate STT provider is used.
ELEVENLABS_API_KEY=

# Optional independent backup routes. Keep these server-only; never place keys in browser assets.
# Netlify-injected OPENROUTER_API_KEY is the Gateway, NOT the direct backup.
OPENROUTER_DIRECT_API_KEY=
OPENROUTER_DIRECT_BASE_URL=
OPENAI_DIRECT_API_KEY=
OPENAI_DIRECT_BASE_URL=

# Concurrency overlap guards only; Zeus and Olympus have no hourly execution cap.
OLYHUB_ZEUS_CONCURRENCY=2
OLYHUB_OLYMPUS_CONCURRENCY=1
OLYHUB_INVALID_MODEL_TTL_MS=21600000
# Mandatory allowlist for explicit GitHub write actions; blank = disabled.
GITHUB_TOKEN=
GITHUB_REPO_ALLOWLIST=
# Optional access-token rotation grace, expires within 30 days.
ZEUS_PROXY_ACCESS_TOKEN_PREVIOUS=
ZEUS_PROXY_ACCESS_TOKEN_PREVIOUS_UNTIL=

# Zeus Proxy: ONE $60 monthly monitoring target across all services.
# Soft alert only: NEVER block image, video, audio or text generation at this
# threshold. Provider invoices are authoritative; not all media costs are yet
# captured automatically in the in-app usage record.
ZEUS_MONTHLY_TOTAL_USD=60

# Live Talk speech order: ElevenLabs custom voice → OpenAI TTS via Netlify
# AI Gateway → Gemini TTS via Netlify AI Gateway.
# Add these as server-side Netlify Function/runtime environment variables.
# Keep ELEVENLABS_API_KEY secret and set ELEVENLABS_VOICE_ID to your voice ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional model overrides; defaults are eleven_multilingual_v2,
# gpt-4o-mini-tts and gemini-3.8-flash-tts.
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
# GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts
# GEMINI_SPEECH_VOICE=Kore

# Optional Google OAuth. Google Cloud OAuth Web client + consent screen required.
# Redirect URI example for the currently known personal Netlify host:
# https://zeus-olyhub.netlify.app/api/google-integration/callback
# Enable Gmail API, Google Calendar API and Google Drive API in Google Cloud.
# Use a random 32-byte encryption key encoded as 64 hex characters.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_ENCRYPTION_KEY=
