# Provider API keys and provider base URLs are supplied at runtime by Netlify AI Gateway.
# Do not put provider credentials in this file. Add only the optional app configuration below.
OPENAI_MODEL=gpt-6.1-sol
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-3.1-pro-preview
PROVIDER_TIMEOUT_MS=30000
ZEUS_PROVIDER_ORDER=openai,claude,gemini

# Required in production. Generate a unique random value of at least 32 characters.
# The user enters this in the app; it is sent only to this server's chat endpoint.
ZEUS_PROXY_ACCESS_TOKEN=

# Optional server-side persistence. Keep service-role credentials private.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
